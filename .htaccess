# StockerTV is a single-page app. Each page has a pre-rendered file (feed.html, ...);
# every other address that isn't a real file opens index.html,
# so /feed, /demo, /privacy and the others work when opened directly or refreshed.
Options -MultiViews
RewriteEngine On
# Pre-rendered pages: /feed is served from feed.html (readable without JavaScript)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# Videos: let browsers seek and start playing before the whole file arrives
AddType video/mp4 .mp4
AddType application/manifest+json .webmanifest
